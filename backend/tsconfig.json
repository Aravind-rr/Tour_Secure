{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2020",
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node"
  },
  "include": ["src/index.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/server.ts",
    "scripts"
  ]
}