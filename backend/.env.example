PORT=4000
NODE_ENV=development
MONGO_URL=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>/<DB>?retryWrites=true&w=majority
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVER_BASE_URL=http://localhost:8080
JWT_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
AUTH_COOKIE_NAME=toursecure_token
FILE_STORAGE_DIR=./secure_uploads
# Optional:
# CONTRACT_ADDRESS=
# BLOCKCHAIN_RPC=
# BLOCKCHAIN_PRIVATE_KEY=

# ---- AI assistant (optional) ----
# Without a key the assistant runs in offline (rule-based) mode using the same tools.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ASSISTANT_RATE_PER_MIN=20

# ---- Recommendations ----
# Live OpenStreetMap places + Nominatim geocoding (falls back to the curated catalogue offline)
# ENABLE_OSM=true
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# ENABLE_GEOCODER=true
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
# GEOCODER_COUNTRIES=in

# ---- SOS / check-ins ----
# Public URL of the frontend, used to build live-tracking links (defaults to first CORS origin)
# PUBLIC_APP_URL=http://localhost:5173
# Optional webhook (Slack/Discord/Teams/Twilio Function…) that receives every new alert as JSON
# ALERT_WEBHOOK_URL=
# CHECKIN_GRACE_SECONDS=120
# ALERT_SHARE_TTL_HOURS=24
